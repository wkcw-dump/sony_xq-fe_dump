# Audio
aaudio.hw_burst_min_usec=2000
aaudio.mmap_exclusive_policy=2
aaudio.mmap_policy=2
af.fast_track_multiplier=1
audio.deep_buffer.media=true
audio.offload.min.duration.secs=60
audio.offload.video=false
audio.sys.mute.latency.factor=2
audio.sys.noisy.broadcast.delay=500
audio.sys.offload.pstimeout.secs=3
audio.timecheck.timeout_duration_ms=8000
ro.vendor.audio.effect.support_dolby=false
vendor.audio.bt.hearing_protection.ce=true

# Bluetooth
bluetooth.device.class_of_device=90,2,12
bluetooth.device_id.product_id=6475
bluetooth.device_id.vendor_id=4046
bluetooth.device_id.vendor_id_source=2
bluetooth.leaudio.dual_bidirection_swb.supported=true
bluetooth.profile.a2dp.source.enabled=true
bluetooth.profile.asha.central.enabled=true
bluetooth.profile.avrcp.controller.enabled=true
bluetooth.profile.avrcp.target.enabled=true
bluetooth.profile.avrcp.target.multiple_players.enabled=true
bluetooth.profile.bas.client.enabled=true
bluetooth.profile.gatt.enabled=true
bluetooth.profile.hfp.ag.enabled=true
bluetooth.profile.hid.device.enabled=true
bluetooth.profile.hid.host.enabled=true
bluetooth.profile.map.server.enabled=true
bluetooth.profile.opp.enabled=true
bluetooth.profile.pan.nap.enabled=true
bluetooth.profile.pan.panu.enabled=true
bluetooth.profile.pbap.server.enabled=true
persist.bluetooth.avrcpversion=avrcp16
persist.bluetooth.bqr.event_mask=295006
persist.bluetooth.bqr.min_interval_ms=500
persist.bluetooth.disableinbandringing=false
persist.bluetooth.iso_link_quality_report=true
persist.bluetooth.leaudio.bypass_allow_list=true
persist.bluetooth.leaudio.notify.idle.during.call=true
persist.bluetooth.leaudio_offload.disabled=false
ro.bluetooth.leaudio_offload.supported=true

# Display
debug.sf.enable_transaction_tracing=false

# Media
media.recorder.show_manufacturer_and_model=true
media.stagefright.audio.deep=false

# Wi-Fi
ro.wifi.channels=

# Miscellaneous
dalvik.vm.systemuicompilerfilter=speed
masterclear.allow_retain_esim_profiles_after_fdr=true
net.tethering.noprovisioning=true
persist.enable.bluetooth.voipleawar=true
persist.sys.strictmode.disable=true
persist.wm.extensions.enabled=true
remote_provisioning.enable_rkpd=true
remote_provisioning.hostname=remoteprovisioning.googleapis.com
remote_provisioning.strongbox.rkp_only=true
ro.af.client_heap_size_kbyte=7168
ro.build.version.sdk_full=36.1
ro.com.android.mobiledata=false
ro.config.alarm_alert=Hassium.ogg
ro.config.notification_sound=Argon.ogg
ro.config.ringtone=Orion.ogg
ro.control_privapp_permissions=enforce
ro.lineage.build.version=23.2
